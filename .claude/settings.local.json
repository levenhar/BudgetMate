{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "WebSearch",
      "Bash(playwright:*)",
      "Bash(python scrape_base44.py)",
      "Bash(npm install:*)",
      "mcp__supabase__list_projects",
      "mcp__supabase__get_project",
      "mcp__supabase__*",
      "mcp__claude_ai_Gmail__gmail_get_profile",
      "mcp__vercel__deploy_to_vercel",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_type",
      "mcp__plugin_playwright_playwright__browser_press_key",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_install",
      "mcp__claude_ai_Gmail__gmail_search_messages",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_run_code",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "WebFetch(domain:api.github.com)",
      "Skill(update-config)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(mv:*)",
      "Bash(powershell:*)",
      "Bash(cmd:*)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [ -n \"$f\" ] && echo \"$f\" | grep -qE '\\.(ts|tsx)$' && { npm run typecheck 2>&1 | tail -20 || exit 2; }; true",
            "asyncRewake": true,
            "timeout": 60,
            "statusMessage": "Type-checking..."
          }
        ]
      }
    ]
  }
}
