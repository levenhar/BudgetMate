{
  "name": "RecurringExpense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d4\u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4"
    },
    "category_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "category_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ],
      "default": "monthly",
      "description": "\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "household_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05e7 \u05d1\u05d9\u05ea (null \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05e9\u05d9)"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e6\u05e8"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    }
  },
  "required": [
    "name",
    "amount",
    "category_id",
    "frequency",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "household_id": null
        },
        {
          "$and": [
            {
              "household_id": "{{user.data.current_household_id}}"
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "household_id": null
        },
        {
          "household_id": "{{user.data.current_household_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "household_id": null
        },
        {
          "household_id": "{{user.data.current_household_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "household_id": null
        },
        {
          "household_id": "{{user.data.current_household_id}}"
        }
      ]
    }
  }
}